# Keep browser requests same-origin; Vite/Nginx proxy them to the deployed server.
# Production auto-detects chat.starsnap.kr. Set VITE_APP_SURFACE=chat for local chat UI checks.
VITE_APP_SURFACE=
VITE_SOCIAL_APP_URL=https://sns.starsnap.kr
VITE_PUBLIC_LOCAL_API_HOST=
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_REPORT_BASE_URL=
VITE_ADMIN_API_BASE_URL=http://localhost:8082
VITE_GOOGLE_CLIENT_ID=
VITE_S3_OUTPUT_BUCKET_URL=https://starsnap.kr
VITE_S3_INPUT_BUCKET_URL=https://starsnap.kr
